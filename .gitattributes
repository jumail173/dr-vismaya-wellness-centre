# Normalise text files to LF in the repository and in every checkout, so a local
# `node build.js` produces a byte-identical payload to the Cloudflare Pages build.
# Without this, core.autocrlf=true rewrites sitemap.xml to CRLF locally (1029 bytes)
# while the committed blob stays LF (997 bytes).
* text=auto eol=lf

*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.xml  text eol=lf
*.txt  text eol=lf
*.md   text eol=lf

# binaries - never touched
*.webp binary
*.png  binary
*.jpg  binary
*.ico  binary
*.cur  binary